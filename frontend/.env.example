# Frontend configuration. Copy to .env.local to override (never commit secrets here:
# every VITE_ variable is bundled into the public JavaScript).
#   PowerShell:  Copy-Item .env.example .env.local

# Base URL of the backend API. Its origin must be listed in the backend's CORS_ORIGINS.
VITE_API_URL=http://127.0.0.1:8000/api/v1
