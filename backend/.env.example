# =============================================================================
# AI Customer Support Automation System - backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
# Leaving a value empty (NAME=) means "use the default".
# =============================================================================

# ---- Application ----
APP_NAME="AI Customer Support"
ENVIRONMENT=development          # development | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # true = one JSON object per log line

# ---- Security -------------------------------------------------------------
# REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database -------------------------------------------------------------
# SQLite for local dev. PostgreSQL later, e.g.
#   postgresql+psycopg://user:password@localhost:5432/support
DATABASE_URL=sqlite:///./support.db

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI providers ---------------------------------------------------------
# LLM_PROVIDER:       gemini | demo
#   demo  = no AI model: answers quote the matching document sentences (offline).
# EMBEDDING_PROVIDER: gemini | local
#   local = offline word-hashing embeddings (no key; matches shared words only).
# Changing EMBEDDING_PROVIDER or the embedding model requires "Rebuild index".
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verify these model names against your own key before relying on them:
#   python scripts/check_provider.py
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=50

LLM_TEMPERATURE=0.2
# Includes "thinking" tokens on models that think before answering.
LLM_MAX_OUTPUT_TOKENS=2048
# Bounded retries with exponential backoff for timeouts, rate limits and 5xx errors.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1.0

# ---- File storage ---------------------------------------------------------
UPLOAD_DIR=./storage/uploads
VECTOR_INDEX_DIR=./storage/vector_index
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md

# ---- RAG pipeline ---------------------------------------------------------
CHUNK_SIZE=1000                  # characters per chunk
CHUNK_OVERLAP=150                # character overlap between chunks
RETRIEVAL_TOP_K=5                # passages given to the answer generator
# Similarity thresholds depend on the embedding model. Leave empty to use the
# provider's defaults (local: 0.10 / 0.22, gemini: 0.50 / 0.60 - uncalibrated).
# Calibrate with:  python scripts/evaluate_rag.py --sweep
RETRIEVAL_MIN_SCORE=             # passages below this similarity are ignored
ESCALATION_MIN_TOP_SCORE=        # best passage weaker than this -> escalate
ESCALATION_MIN_CHUNKS=1          # fewer usable passages than this -> escalate
ESCALATION_MIN_COVERAGE=0.3      # share of question key terms found in passages
CHAT_HISTORY_TURNS=6             # previous messages sent to the model for context
MAX_QUESTION_LENGTH=2000

# ---- Background jobs (Celery + Redis) -------------------------------------
# Windows: Memurai Developer Edition provides a native Redis-compatible server.
# Celery on Windows must run with --pool=solo; worker setup is in docs/WINDOWS_SETUP.md.
REDIS_URL=redis://localhost:6379/0
# Runs tasks inside the API process. For the automated tests only.
CELERY_TASK_ALWAYS_EAGER=false
